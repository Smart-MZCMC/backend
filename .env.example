APP_NAME=Goravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true

LOG_CHANNEL=stack
LOG_LEVEL=debug

SESSION_DRIVER=file
SESSION_LIFETIME=120

APP_URL=http://localhost
APP_HOST=127.0.0.1
APP_PORT=3000

JWT_SECRET=

AI_PROVIDER=

OPENAI_API_KEY=
OPENAI_BASE_URL=

DB_CONNECTION=postgres
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

GRPC_HOST=
GRPC_PORT=

MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# === 插件配置（配置项见 config/plugins.go）===
# ntfy-alert：导播掉线 / 控制权超时 / 采访点离线告警。
# 两项都填才会启用；只填一项视为配置不完整并停用，避免告警静默丢失。
# 配置齐全但仍想关闭时，把 PLUGIN_NTFY_ENABLED 设为 false。
NTFY_SERVER=
NTFY_TOPIC=
PLUGIN_NTFY_ENABLED=

# log-archive：定期删除过期消息日志。检查间隔支持 30s / 5m / 1h 写法。
PLUGIN_LOG_ARCHIVE_ENABLED=true
PLUGIN_LOG_RETENTION_DAYS=30
PLUGIN_LOG_CHECK_INTERVAL=1h

# csv-export：日志导出接口（JSON / CSV）。
PLUGIN_CSV_EXPORT_ENABLED=true
