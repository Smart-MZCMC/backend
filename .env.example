APP_NAME=Goravel
APP_ENV=local
# 留空即可：首次启动时后端会自动生成一个 32 位密钥写回本文件。
# （框架在 APP_KEY 缺失或长度不是 32 时会拒绝启动，所以不能一直空着。）
APP_KEY=
APP_DEBUG=true

LOG_CHANNEL=stack
LOG_LEVEL=debug

SESSION_DRIVER=file
SESSION_LIFETIME=120

# 对外访问地址。局域网部署填写 http://<内网IP>:3000，反代部署填域名。
# 首次启动的初始化向导会帮你写这三项。
APP_URL=http://localhost
APP_HOST=127.0.0.1
APP_PORT=3000

# 留空即可：首次启动时后端会自动生成一个 32 位密钥写回本文件。
JWT_SECRET=

AI_PROVIDER=

OPENAI_API_KEY=
OPENAI_BASE_URL=

# 数据库：本项目只注册了 sqlite 驱动（见 config/database.go），固定用 SQLite。
# 路径相对进程工作目录，随发布包一起备份即可。
DB_CONNECTION=sqlite
DB_DATABASE=database/smart-mzcmc.db
# 以下是 Goravel 模板遗留的 PostgreSQL 配置，当前项目不使用，保留仅为兼容。
# DB_HOST=
# DB_PORT=
# DB_USERNAME=
# DB_PASSWORD=

GRPC_HOST=
GRPC_PORT=

MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# === 插件配置（配置项见 config/plugins.go）===
# ntfy-alert：导播掉线 / 控制权超时 / 采访点离线告警。
# 两项都填才会启用；只填一项视为配置不完整并停用，避免告警静默丢失。
# 配置齐全但仍想关闭时，把 PLUGIN_NTFY_ENABLED 设为 false。
NTFY_SERVER=
NTFY_TOPIC=
PLUGIN_NTFY_ENABLED=

# log-archive：定期删除过期消息日志。检查间隔支持 30s / 5m / 1h 写法。
PLUGIN_LOG_ARCHIVE_ENABLED=true
PLUGIN_LOG_RETENTION_DAYS=30
PLUGIN_LOG_CHECK_INTERVAL=1h

# 采访端掉线扫描。与上面的清理共用一个后台 goroutine，只是走另一个 ticker。
#
# 采访端走出 WiFi 覆盖范围时 TCP 要等很久才报错，连接在服务端看起来仍然是
# 「正常」的。没有这条扫描，导播端会一直显示绿色「就绪」，而记者其实早就
# 失联了。默认 60 秒扫一次、90 秒无任何消息即判离线。
PLUGIN_PRESENCE_SCAN_INTERVAL=60s
PLUGIN_PRESENCE_TIMEOUT=90s

# csv-export：日志导出接口（JSON / CSV）。
PLUGIN_CSV_EXPORT_ENABLED=true

# === 项目授权（配置项见 config/authz.go）===
#
# user_projects 表是否真的参与鉴权。这张表从第一天就在，但此前只被管理接口
# 增删查，从未决定过任何人能看什么：后勤账号能看到全部项目，控制权接口只从
# URL 取 projectId，WebSocket 知道 project_id 就能监听整个项目。
#
# 默认 false 是刻意的：现有部署里未必给每个人都配了项目授权，直接打开会让
# 现场当场连不上。关闭时中间件只把「本来会被拦下的请求」写进日志——先看一遍
# 名单，确认授权都配齐了再改成 true。
REQUIRE_PROJECT_MEMBERSHIP=false

# 谁能登录**管理后台网页**（管理后台专用登录入口 /api/auth/admin-login 校验它）。
#
# 取一个角色名：super_admin / admin / leader / director / packaging /
# commentator / pre_production / logistics。语义是「等级 >= 该角色」，所以填
# logistics（最低档）等于谁都能进后台。
#
# 默认 leader：网页后台是「管理与查看」的界面，导播、包装、解说、前期、后勤的
# 工作都在各自的原生客户端上完成，没有理由进后台——导播尤其如此，它的切台
# 动作走 /api/locks/*，而网页后台里根本没有切台入口。
#
# 为什么不用具名权限来表达这一条：这里要的是「一道门槛」，而等级天然就是一道
# 门槛；「除导播以外的所有角色都能进」这种形状在等级上表达不出来（导播 30 夹在
# 中间，把门槛压到 40 会把包装、解说、前期、后勤一起挡掉），要放开某一档只能改
# 这个值。注意原生客户端（导播端 / 解说端 / 包装端 / 采访端）走的是
# /api/auth/login，不受这一项限制。
#
# 填了非法角色名时后端会退回 leader 并在日志里记一笔。
ADMIN_MIN_ROLE=leader

# === 在线更新（配置项见 config/update.go）===
#
# 管理后台「系统设置」页用的在线更新：从 GitHub Release 拉取后端发布包，
# 校验 sha256 之后替换可执行文件并重启。默认关闭，因为它会改动服务自身。
UPDATE_ENABLED=false

# GitHub 仓库（owner/repo）。仅在 UPDATE_SERVER 留空时使用。
UPDATE_REPO=Smart-MZCMC/backend

# 发布包资产名，必须与 release.yml 产出的文件名一致。
UPDATE_ASSET=backend-linux-amd64.tar.gz

# 留空 = 走 GitHub 官方 API。要指向自建的 GitHub 兼容 API（例如 Gitea），
# 必须带上它自己的 /api/v1 前缀，例如 http://192.168.1.10/api/v1
UPDATE_SERVER=

# 资产下载镜像前缀。与 UPDATE_SERVER 无关，管的是另一件事：
# 「查得到版本」但「下不动包」。
#
# Release 资产走的是 github.com 的下载域名，而这个域名经常被 TCP 阻断
# （本项目推代码时就撞上过），表现为「能查到有新版，一点更新就卡住不动」。
# 配一个前缀即可，最终请求 {前缀}{原始URL}：
#
#   UPDATE_DOWNLOAD_MIRROR=https://github.laobinghu.top/
#
# ⚠️ 用了镜像就意味着**包的校验值也来自镜像**：校验和与被校验的包由同一方
# 提供，攻破镜像即可同时替换两者，sha256 校验就形同虚设。
# 真正的完整性保证需要下面的 UPDATE_CHECKSUM_URL。
UPDATE_DOWNLOAD_MIRROR=

# checksums.txt 的可信地址。留空 = 跟随资产来源（同样经上面的镜像取回）。
#
# 用了镜像之后这一项就成了必要配套：校验和必须来自与包**不同**的源，
# 「异源比对」才是校验，「同源自证」只是形式。
# 校园网里常见的做法是把它放到自己控制的 HTTP 服务上。
UPDATE_CHECKSUM_URL=

# 可选。GitHub 未登录时 API 限流是每小时 60 次/IP；内网多台机器共用一个
# 出口 IP 时很容易撞上。配了 token 是 5000 次/小时。
UPDATE_TOKEN=

# 允许「应用更新」真正替换可执行文件。
#
# 保持 false 时，apply 只把新版本下载、校验并解压到 update/ 目录，由运维
# 确认后手工替换 —— 适合先看清会发生什么。
#
# 置为 true 有个前提：进程必须由 systemd 之类的管理器托管。替换后本进程会
# 退出，若只是直接 ./smart-mzcmc 起的，退出就等于停服。这是默认关闭的另一
# 个原因，详见 DEPLOY.md 的「在线更新」。
UPDATE_ALLOW_REPLACE=false

# === 头像（配置项见 config/avatar.go）===
#
# 用 WeAvatar（https://weavatar.com）：Gravatar 的国内可用替代，不翻墙。
# 按 md5(邮箱去空格转小写) 取图，管理后台展示用。
#
# 做成可配置是为了留后路：校园内网无外网时可以指向自建镜像或代理地址。
AVATAR_BASE_URL=https://weavatar.com/avatar

# 头像边长（像素）。界面只展示 32px，取 96 是为了在高 DPI 屏上不发虚。
AVATAR_SIZE=96
